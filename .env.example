# Browser-safe Supabase settings used by React/Vite.
# Get these from Supabase Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GitHub Pages base path.
# Use "/" for username.github.io repositories.
# Use "/repo-name/" for project repositories.
VITE_PUBLIC_BASE_PATH=/oriontanitim/

# WhatsApp phone number in international format without "+".
VITE_WHATSAPP_PHONE=905327236648

# Admin username login maps "admin" to "admin@orionkamp.local" for Supabase Auth.
VITE_ADMIN_USERNAME_DOMAIN=orionkamp.local

# Used only when Supabase settings are empty, for local/demo admin access.
VITE_DEMO_ADMIN_USERNAME=admin
VITE_DEMO_ADMIN_PASSWORD=orion2026
